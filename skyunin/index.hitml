<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>S級任務</title>
  <meta name="description" content="S級任務 — 東京発ポップスバンド。Hayate / Kin-chan / ギタリスト?" />
  <style>
    :root {
      --bg:    #0a0a0a;
      --fg:    #f0ede8;
      --muted: rgba(240,237,232,.35);
      --line:  rgba(240,237,232,.08);
      --red:   #b5272a;
      --red-l: #d93a3e;
      --f:     -apple-system, 'Helvetica Neue', Arial, sans-serif;
      --ease:  cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--fg);
      font-family: var(--f);
      font-size: 13px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    img, video { display: block; width: 100%; height: 100%; object-fit: cover; }
    a { color: inherit; text-decoration: none; }
    button { background: none; border: none; cursor: pointer; font: inherit; color: inherit; }

    /* ── NAV ── */
    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      padding: 20px 28px;
      display: flex; justify-content: space-between; align-items: center;
      transition: background .4s;
    }
    .nav.scrolled {
      background: rgba(10,10,10,.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }
    .nav-name {
      font-size: 12px; letter-spacing: .1em;
      font-weight: 600;
    }
    .nav-back {
      font-size: 10px; letter-spacing: .1em;
      color: var(--muted);
      transition: color .2s;
    }
    .nav-back:hover { color: var(--fg); }
    .nav-links { list-style: none; display: flex; gap: 24px; }
    .nav-links a {
      font-size: 11px; letter-spacing: .08em;
      color: var(--muted); transition: color .2s;
    }
    .nav-links a:hover { color: var(--fg); }

    /* ── HERO ── */
    .hero {
      position: relative; height: 100vh;
      display: flex; align-items: flex-end;
      overflow: hidden; background: #000;
    }
    .hero-media {
      position: absolute; inset: 0;
    }
    .hero-media video,
    .hero-media img { position: absolute; inset: 0; opacity: .6; }
    .hero-grad {
      position: absolute; inset: 0;
      background: linear-gradient(
        to bottom,
        transparent 30%,
        rgba(10,10,10,.7) 80%,
        var(--bg) 100%
      );
    }
    .hero-content {
      position: relative; z-index: 2;
      padding: 0 28px 52px;
    }
    .hero-tag {
      font-size: 10px; letter-spacing: .2em;
      text-transform: uppercase; color: var(--red-l);
      margin-bottom: 12px;
    }
    .hero-name {
      font-size: clamp(3.5rem, 12vw, 10rem);
      font-weight: 700; letter-spacing: -.03em;
      line-height: .9;
    }
    .hero-sub {
      font-size: 11px; letter-spacing: .1em;
      color: var(--muted); margin-top: 16px;
    }
    .hero-scroll {
      position: absolute; bottom: 28px; right: 28px;
      font-size: 10px; letter-spacing: .14em;
      text-transform: uppercase; color: var(--muted);
      writing-mode: vertical-rl;
      display: flex; align-items: center; gap: 10px;
    }
    .hero-scroll::before {
      content: ''; display: block;
      width: 1px; height: 40px;
      background: rgba(240,237,232,.15);
    }

    /* ── MUSIC ── */
    #music { padding: 100px 28px 80px; }
    .section-label {
      font-size: 10px; letter-spacing: .2em;
      text-transform: uppercase; color: var(--muted);
      margin-bottom: 40px;
    }

    /* 最新シングル — 大きく */
    .featured-track {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 48px; align-items: center;
      border-top: 1px solid var(--line);
      padding-top: 40px; margin-bottom: 60px;
    }
    .featured-artwork {
      aspect-ratio: 1; overflow: hidden;
      background: #1a1a1a; position: relative;
    }
    .featured-artwork img {
      position: absolute; inset: 0;
    }
    .featured-body {}
    .featured-new {
      font-size: 9px; letter-spacing: .2em;
      text-transform: uppercase; color: var(--red-l);
      margin-bottom: 12px;
    }
    .featured-title {
      font-size: clamp(1.8rem, 4vw, 3.5rem);
      font-weight: 700; letter-spacing: -.02em;
      line-height: 1; margin-bottom: 16px;
    }
    .featured-desc {
      font-size: 12px; line-height: 1.8;
      color: var(--muted); margin-bottom: 28px;
      max-width: 36ch;
    }
    .track-links { display: flex; gap: 12px; flex-wrap: wrap; }
    .track-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 11px; letter-spacing: .08em;
      padding: 8px 16px;
      border: 1px solid rgba(240,237,232,.2);
      transition: background .2s, border-color .2s, color .2s;
    }
    .track-link:hover { border-color: var(--fg); }
    .track-link.primary {
      background: var(--red); border-color: var(--red); color: #fff;
    }
    .track-link.primary:hover { background: var(--red-l); border-color: var(--red-l); }

    /* 曲リスト */
    .tracks { border-top: 1px solid var(--line); }
    .track-row {
      display: grid; grid-template-columns: 2rem 1fr auto;
      align-items: center; gap: 16px;
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
      cursor: pointer; transition: background .15s;
    }
    .track-row:hover { background: rgba(240,237,232,.03); }
    .track-num { font-size: 11px; color: var(--muted); text-align: right; }
    .track-name { font-size: 13px; }
    .track-year { font-size: 11px; color: var(--muted); }

    /* ── MV ── */
    #mv { padding: 80px 28px; border-top: 1px solid var(--line); }
    .mv-grid {
      display: grid; grid-template-columns: repeat(2, 1fr);
      gap: 3px; margin-top: 40px;
    }
    .mv-item {
      position: relative; aspect-ratio: 16/9;
      overflow: hidden; background: #111;
      cursor: pointer;
    }
    .mv-item img, .mv-item video {
      position: absolute; inset: 0;
      transition: transform .6s var(--ease);
    }
    .mv-item:hover img,
    .mv-item:hover video { transform: scale(1.04); }
    .mv-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(transparent 40%, rgba(0,0,0,.7) 100%);
      display: flex; flex-direction: column;
      justify-content: flex-end; padding: 16px 18px;
      opacity: 0; transition: opacity .3s;
    }
    .mv-item:hover .mv-overlay { opacity: 1; }
    .mv-play {
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 48px; height: 48px;
      border: 1px solid rgba(255,255,255,.4);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px;
      opacity: 0; transition: opacity .3s;
    }
    .mv-item:hover .mv-play { opacity: 1; }
    .mv-title { font-size: 12px; color: #fff; }
    .mv-tag { font-size: 10px; color: rgba(255,255,255,.45); margin-top: 2px; }

    /* ── LIVE ── */
    #live { padding: 80px 28px; border-top: 1px solid var(--line); }
    .live-list { margin-top: 40px; }
    .live-row {
      display: grid;
      grid-template-columns: 80px 1fr auto;
      gap: 24px; align-items: start;
      padding: 20px 0;
      border-bottom: 1px solid var(--line);
    }
    .live-date {
      font-size: 11px; letter-spacing: .06em;
      color: var(--muted); line-height: 1.5;
    }
    .live-date .day {
      font-size: 22px; font-weight: 600;
      color: var(--fg); display: block;
      letter-spacing: -.02em;
    }
    .live-info {}
    .live-title { font-size: 13px; font-weight: 500; margin-bottom: 4px; }
    .live-venue { font-size: 11px; color: var(--muted); }
    .live-ticket {
      font-size: 10px; letter-spacing: .1em;
      text-transform: uppercase;
      padding: 6px 12px;
      border: 1px solid rgba(240,237,232,.2);
      transition: border-color .2s;
      white-space: nowrap; align-self: center;
    }
    .live-ticket:hover { border-color: var(--fg); }
    .live-ticket.sold { color: var(--muted); cursor: default; }
    .live-empty {
      padding: 40px 0;
      font-size: 12px; color: var(--muted);
    }

    /* ── MEMBERS ── */
    #members { padding: 80px 28px; border-top: 1px solid var(--line); }
    .members-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 3px; margin-top: 40px;
    }
    .member {
      position: relative; overflow: hidden;
      background: #111;
    }
    .member-photo {
      aspect-ratio: 3/4; overflow: hidden;
      position: relative;
    }
    .member-photo img {
      position: absolute; inset: 0;
      transition: transform .6s var(--ease);
    }
    .member:hover .member-photo img { transform: scale(1.04); }
    .member-info {
      padding: 16px 16px 20px;
      border-top: 1px solid var(--line);
    }
    .member-role {
      font-size: 9px; letter-spacing: .18em;
      text-transform: uppercase; color: var(--red-l);
      margin-bottom: 6px;
    }
    .member-name { font-size: 15px; font-weight: 600; letter-spacing: .02em; }
    .member-note { font-size: 11px; color: var(--muted); margin-top: 4px; line-height: 1.6; }

    /* ── STORE ── */
    #store { padding: 80px 28px; border-top: 1px solid var(--line); }
    .store-coming {
      margin-top: 40px;
      padding: 60px 40px;
      border: 1px solid var(--line);
      text-align: center;
    }
    .store-coming-label {
      font-size: 10px; letter-spacing: .2em;
      text-transform: uppercase; color: var(--red-l);
      margin-bottom: 16px;
    }
    .store-coming-title {
      font-size: clamp(1.5rem, 3vw, 2.5rem);
      font-weight: 700; letter-spacing: -.02em;
      margin-bottom: 12px;
    }
    .store-coming-sub {
      font-size: 12px; color: var(--muted);
    }
    /* 将来の商品グリッド（今は非表示） */
    .store-grid {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 20px; margin-top: 40px;
      display: none; /* 販売開始時に削除 */
    }
    .store-item { cursor: pointer; }
    .store-thumb {
      aspect-ratio: 1; background: #111;
      overflow: hidden; margin-bottom: 12px;
    }
    .store-name { font-size: 12px; margin-bottom: 4px; }
    .store-price { font-size: 11px; color: var(--muted); }

    /* ── CONTACT / SNS ── */
    #contact { padding: 80px 28px 100px; border-top: 1px solid var(--line); }
    .contact-inner {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 60px; align-items: start;
    }
    .contact-heading {
      font-size: clamp(2rem, 5vw, 4rem);
      font-weight: 700; letter-spacing: -.03em;
      line-height: 1;
    }
    .contact-heading .red { color: var(--red-l); }
    .sns-list { display: flex; flex-direction: column; gap: 12px; }
    .sns-row {
      display: flex; justify-content: space-between;
      align-items: center;
      padding: 12px 0; border-bottom: 1px solid var(--line);
    }
    .sns-name { font-size: 11px; letter-spacing: .08em; color: var(--muted); }
    .sns-handle { font-size: 13px; }
    .sns-arrow { font-size: 11px; color: var(--muted); transition: transform .2s; }
    .sns-row:hover .sns-arrow { transform: translateX(4px); }
    .contact-mail {
      margin-top: 28px;
      font-size: 12px; color: var(--muted);
    }
    .contact-mail a { color: var(--fg); border-bottom: 1px solid var(--line); transition: border-color .2s; }
    .contact-mail a:hover { border-color: var(--fg); }

    /* ── FOOTER ── */
    footer {
      padding: 20px 28px;
      border-top: 1px solid var(--line);
      display: flex; justify-content: space-between; align-items: center;
    }
    .footer-name { font-size: 11px; letter-spacing: .06em; font-weight: 600; }
    .footer-copy { font-size: 10px; color: var(--muted); }
    .footer-parent {
      font-size: 10px; color: var(--muted);
      transition: color .2s;
    }
    .footer-parent:hover { color: var(--fg); }

    /* ── REVEAL ── */
    .reveal {
      opacity: 0; transform: translateY(16px);
      transition: opacity .7s var(--ease), transform .7s var(--ease);
    }
    .reveal.in { opacity: 1; transform: none; }
    .d1 { transition-delay: .08s; }
    .d2 { transition-delay: .16s; }
    .d3 { transition-delay: .24s; }

    /* ── RESPONSIVE ── */
    @media (max-width: 768px) {
      .featured-track { grid-template-columns: 1fr; gap: 28px; }
      .mv-grid { grid-template-columns: 1fr; }
      .members-grid { grid-template-columns: 1fr 1fr; }
      .contact-inner { grid-template-columns: 1fr; gap: 40px; }
      .live-row { grid-template-columns: 60px 1fr; }
      .live-ticket { display: none; }
      .store-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 480px) {
      .nav-links { display: none; }
      .members-grid { grid-template-columns: 1fr; }
      .track-row { grid-template-columns: 1.5rem 1fr auto; gap: 10px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal { transition: none !important; }
      .mv-item img, .mv-item video,
      .member .member-photo img { transition: none !important; }
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav class="nav" id="nav">
  <span class="nav-name">S級任務</span>
  <ul class="nav-links">
    <li><a href="#music">Music</a></li>
    <li><a href="#mv">MV</a></li>
    <li><a href="#live">Live</a></li>
    <li><a href="#members">Members</a></li>
    <li><a href="#store">Store</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
  <a href="../" class="nav-back">← OOPartsArts</a>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-media">
    <!--
      ★ ヒーロー: 動画または画像
      <video src="../videos/skyunin-hero.mp4" autoplay loop muted playsinline></video>
      または
      <img src="images/hero.jpg" alt="S級任務" />
    -->
  </div>
  <div class="hero-grad"></div>
  <div class="hero-content">
    <p class="hero-tag">Tokyo — Pop Band</p>
    <h1 class="hero-name">S級任務</h1>
    <p class="hero-sub">Hayate &nbsp;/&nbsp; Kin-chan &nbsp;/&nbsp; ギタリスト?</p>
  </div>
  <div class="hero-scroll" aria-hidden="true">Scroll</div>
</section>

<!-- MUSIC -->
<section id="music">
  <div style="padding: 100px 28px 0;">
    <p class="section-label reveal">Music</p>

    <!-- 最新シングル -->
    <div class="featured-track">
      <div class="featured-artwork reveal">
        <!--
          ★ ジャケット画像
          <img src="images/sanzen-jacket.jpg" alt="燦然" />
        -->
      </div>
      <div class="featured-body">
        <p class="featured-new reveal">Latest Single</p>
        <h2 class="featured-title reveal d1">燦然</h2>
        <p class="featured-desc reveal d2">
          R&B特有のグルーヴを活かしながら、ベースやギターソロを織り交ぜた展開が特徴のポップス。
        </p>
        <div class="track-links reveal d3">
          <!--
            ★ 各配信リンクを入れてください
          -->
          <a href="" target="_blank" rel="noopener" class="track-link primary">▶ YouTube</a>
          <a href="" target="_blank" rel="noopener" class="track-link">Spotify</a>
          <a href="" target="_blank" rel="noopener" class="track-link">Apple Music</a>
        </div>
      </div>
    </div>

    <!-- 曲リスト -->
    <div class="tracks reveal" id="trackList"></div>
  </div>
</section>

<!-- MV -->
<section id="mv">
  <p class="section-label reveal">Music Video</p>
  <div class="mv-grid reveal" id="mvGrid"></div>
</section>

<!-- LIVE -->
<section id="live">
  <p class="section-label reveal">Live</p>
  <div class="live-list reveal" id="liveList"></div>
</section>

<!-- MEMBERS -->
<section id="members">
  <p class="section-label reveal">Members</p>
  <div class="members-grid" id="membersGrid"></div>
</section>

<!-- STORE -->
<section id="store">
  <p class="section-label reveal">Store</p>
  <div class="store-coming reveal">
    <p class="store-coming-label">Coming Soon</p>
    <h2 class="store-coming-title">Goods & Merch</h2>
    <p class="store-coming-sub">準備中です。SNSをフォローしてお待ちください。</p>
  </div>
  <!-- 販売開始時: store-coming を非表示にして store-grid を display:grid に -->
  <div class="store-grid" id="storeGrid"></div>
</section>

<!-- CONTACT -->
<section id="contact">
  <div class="contact-inner">
    <div>
      <p class="section-label reveal">Contact & SNS</p>
      <h2 class="contact-heading reveal">
        Follow<br />
        <span class="red">S級任務.</span>
      </h2>
    </div>
    <div class="reveal d1">
      <div class="sns-list" id="snsList"></div>
      <p class="contact-mail">
        お問い合わせ: <a href="mailto:oopartsartss@gmail.com">oopartsartss@gmail.com</a>
      </p>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <span class="footer-name">S級任務</span>
  <span class="footer-copy">© 2026 S級任務 / OOPartsArts</span>
  <a href="../" class="footer-parent">OOPartsArts →</a>
</footer>

<script>
/* =====================================================
   ★ ここを編集してサイトを更新する
===================================================== */

/* ── 曲リスト ── */
const tracks = [
  { title: "燦然",      year: "2025", url: "" },
  { title: "祈り",      year: "2024", url: "" },
  /* 曲を追加する場合: { title: "曲名", year: "年", url: "YouTubeなどのURL" }, */
];

/* ── MV ── */
const mvs = [
  {
    title: "燦然",
    tag:   "Official MV",
    thumb: "", /* images/sanzen-thumb.jpg */
    url:   "", /* YouTubeのURL */
  },
  {
    title: "祈り",
    tag:   "Official MV",
    thumb: "",
    url:   "",
  },
];

/* ── ライブ情報 ── */
const lives = [
  /*
  {
    month: "Jan",
    day:   "25",
    title: "ライブタイトル",
    venue: "会場名 / 東京",
    ticket: "チケットURL",
    sold:   false,
  },
  */
];

/* ── メンバー ── */
const members = [
  {
    name:  "Hayate",
    role:  "Vocal",
    photo: "", /* images/hayate.jpg */
    note:  "",
  },
  {
    name:  "Kin-chan",
    role:  "Bass",
    photo: "",
    note:  "",
  },
  {
    name:  "ギタリスト?",
    role:  "Guitar",
    photo: "",
    note:  "",
  },
];

/* ── SNS ── */
const sns = [
  { name: "YouTube",   handle: "@S級任務",  url: "" },
  { name: "Instagram", handle: "@handle",   url: "" },
  { name: "X (Twitter)", handle: "@handle", url: "" },
  { name: "TikTok",    handle: "@handle",   url: "" },
];

/* =====================================================
   以下は自動生成 — 編集不要
===================================================== */

/* 曲リスト */
const trackList = document.getElementById('trackList');
if (tracks.length) {
  trackList.innerHTML = tracks.map((t, i) => `
    <div class="track-row" onclick="${t.url ? `window.open('${t.url}','_blank')` : ''}">
      <span class="track-num">${String(i+1).padStart(2,'0')}</span>
      <span class="track-name">${t.title}</span>
      <span class="track-year">${t.year}</span>
    </div>
  `).join('');
}

/* MVグリッド */
const mvGrid = document.getElementById('mvGrid');
mvGrid.innerHTML = mvs.map(m => `
  <div class="mv-item" onclick="${m.url ? `window.open('${m.url}','_blank')` : ''}">
    ${m.thumb ? `<img src="${m.thumb}" alt="${m.title}" loading="lazy" />` : ''}
    <div class="mv-play">▶</div>
    <div class="mv-overlay">
      <p class="mv-title">${m.title}</p>
      <p class="mv-tag">${m.tag}</p>
    </div>
  </div>
`).join('');

/* ライブリスト */
const liveList = document.getElementById('liveList');
if (lives.length) {
  liveList.innerHTML = lives.map(l => `
    <div class="live-row">
      <div class="live-date">
        <span class="day">${l.day}</span>${l.month}
      </div>
      <div class="live-info">
        <p class="live-title">${l.title}</p>
        <p class="live-venue">${l.venue}</p>
      </div>
      ${l.ticket
        ? `<a href="${l.ticket}" target="_blank" class="live-ticket${l.sold?' sold':''}">
            ${l.sold ? 'Sold Out' : 'Ticket →'}
           </a>`
        : ''}
    </div>
  `).join('');
} else {
  liveList.innerHTML = `<p class="live-empty">ライブ情報は近日公開予定です。</p>`;
}

/* メンバー */
document.getElementById('membersGrid').innerHTML = members.map(m => `
  <div class="member reveal">
    <div class="member-photo">
      ${m.photo ? `<img src="${m.photo}" alt="${m.name}" loading="lazy" />` : ''}
    </div>
    <div class="member-info">
      <p class="member-role">${m.role}</p>
      <p class="member-name">${m.name}</p>
      ${m.note ? `<p class="member-note">${m.note}</p>` : ''}
    </div>
  </div>
`).join('');

/* SNS */
document.getElementById('snsList').innerHTML = sns.map(s => `
  <a href="${s.url}" target="_blank" rel="noopener" class="sns-row">
    <span class="sns-name">${s.name}</span>
    <span class="sns-handle">${s.handle}</span>
    <span class="sns-arrow">→</span>
  </a>
`).join('');

/* NAVスクロール */
window.addEventListener('scroll', () => {
  document.getElementById('nav').classList.toggle('scrolled', window.scrollY > 80);
}, { passive: true });

/* リビール */
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
}, { threshold: 0.08 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>
</body>
</html>
